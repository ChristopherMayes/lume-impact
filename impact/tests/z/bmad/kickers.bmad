! Lattice file adapted from simple.bmad
no_digested
beginning[beta_a] = 10.   ! m  a-mode beta function
beginning[beta_b] = 10.   ! m  b-mode beta function
beginning[e_tot] = 10e6   ! eV   Or can set beginning[p0c]

parameter[geometry] = open          ! Or closed
parameter[particle] = electron      ! Reference particle.

hkick1:       hkicker, l = 0.6, bl_kick = 1e-3, num_steps = 10
vkick1:       vkicker, l = 0.6, bl_kick = 1e-3, num_steps = 10
kick1:        kicker, l = 0.6, bl_hkick = 1e-3, bl_vkick = -0.5e-3, num_steps = 10
hkicker_tilt: hkicker, l = 0.6, bl_kick = 1e-3, tilt = 0.3, num_steps = 10

lat: line = (hkick1, hkicker_tilt, vkick1, kick1)
use, lat
